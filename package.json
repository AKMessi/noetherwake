{
  "name": "noetherwake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run content:build && next dev --hostname 0.0.0.0",
    "build": "npm run content:check && next build --webpack && tsx scripts/offline.ts && tsx scripts/budgets.ts",
    "start": "serve out -l 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx scripts/evaluate.ts",
    "content:build": "tsx scripts/content.ts --quick",
    "content:check": "tsx scripts/content.ts",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm test && npm run eval && npm run build"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "dexie": "^4.2.0",
    "katex": "^0.16.22",
    "@cortex-js/compute-engine": "^0.30.2",
    "mathjs": "^15.0.0",
    "gray-matter": "^4.0.3",
    "zod": "^4.1.0",
    "lucide-react": "^0.468.0",
    "@mdx-js/mdx": "^3.1.0",
    "remark-math": "^6.0.0",
    "rehype-katex": "^7.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rehype-stringify": "^10.0.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/katex": "^0.16.7",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "vitest": "^3.2.0",
    "tsx": "^4.20.0",
    "@playwright/test": "^1.56.0",
    "@axe-core/playwright": "^4.10.0",
    "serve": "^14.2.4"
  }
}
